    <string name="help_get_apple">iPhone 和 iPad</string>
    <string name="help_get_apple_where">開發中</string>

    <string name="help_guide_title">逐步說明</string>
    <string name="help_guide_pick">哪兩部裝置？</string>
    <string name="help_guide_phone_pc">手機和電腦</string>
    <string name="help_guide_two_phones">兩支手機</string>
    <string name="help_guide_two_pcs">兩台電腦</string>

    <string name="help_pc_1_title">安裝兩個應用程式</string>
    <string name="help_pc_1_body">這台電腦上安裝 Relay 桌面版，手機上從 Google Play 安裝 Relay Android 版。</string>
    <string name="help_pc_2_title">同一個 Wi-Fi</string>
    <string name="help_pc_2_body">讓電腦和手機連上同一個網路。如果 Windows 詢問防火牆，請選擇在私人網路上允許。</string>
    <string name="help_pc_3_title">連線一次</string>
    <string name="help_pc_3_body">手機會出現在這裡的「附近的新裝置」中。按一下它，確認兩個螢幕顯示相同的三個圖形，然後在手機上輕觸信任。</string>
    <string name="help_pc_4_title">就這樣</string>
    <string name="help_pc_4_body">在一部上複製，在另一部上貼上。把檔案拖到螢幕左邊緣的放置架上，放到手機上；或是從手機分享到這台電腦。</string>

    <string name="help_phones_1_title">在兩支手機上安裝 Relay</string>
    <string name="help_phones_1_body">兩支手機都需要 Google Play 上的應用程式。任何一支都能發起連線。</string>
    <string name="help_phones_2_title">同一個 Wi-Fi 或熱點</string>
    <string name="help_phones_2_body">將兩支手機連上同一個 Wi-Fi。附近沒有 Wi-Fi？開啟一支手機的熱點，讓另一支連上；不需要網際網路。</string>
    <string name="help_phones_3_title">連線一次</string>
    <string name="help_phones_3_body">在任何一支手機上，輕觸「附近的新裝置」中的另一支。確認兩個螢幕顯示相同的三個圖形，然後在第二支手機上輕觸信任。</string>
    <string name="help_phones_4_title">就這樣</string>
    <string name="help_phones_4_body">從任何應用程式在兩支手機之間分享相片和檔案；將兩支手機背對背即可交換名片。</string>

    <string name="help_pcs_1_title">在兩台電腦上安裝 Relay 桌面版</string>
    <string name="help_pcs_1_body">從 GitHub 下載 Windows 或 Linux 版，在每台電腦上執行。它會常駐在系統匣中。</string>
    <string name="help_pcs_2_title">同一個網路</string>
    <string name="help_pcs_2_body">兩台電腦連上同一個 Wi-Fi 或同一個有線網路。在私人網路上允許 Relay 通過防火牆。</string>
    <string name="help_pcs_3_title">連線一次</string>
    <string name="help_pcs_3_body">在一台電腦上，按一下「附近的新裝置」中的另一台。確認兩個螢幕顯示相同的三個圖形，然後在第二台電腦上選擇信任。</string>
    <string name="help_pcs_4_title">就這樣</string>
    <string name="help_pcs_4_body">在一台電腦上複製，在另一台上貼上；或是把檔案拖到螢幕左邊緣的放置架上。</string>

    <string name="settings_ecosystem">生態系</string>
    <string name="settings_ecosystem_title">你的裝置如同一體</string>
    <string name="settings_ecosystem_body">受信任裝置傳送或放置到這裡的任何內容都會立即送達，不必按下接受，而且可以直接貼上。</string>
    <string name="settings_privacy">隱私權</string>
    <string name="settings_analytics_title">協助改善 Relay</string>
    <string name="settings_analytics_body">傳送「完成了一次傳輸」之類的匿名計數，絕不傳送檔案名稱、文字或你的裝置身分。預設為關閉。</string>
    <string name="settings_shelf_title">放置架</string>
    <string name="settings_shelf_body">螢幕左邊緣的一個細長分頁。把任何檔案或文字拖到上面，再放到某部裝置上。</string>

