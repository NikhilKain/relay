    <string name="settings_share_message">أستخدم Relay لنقل الملفات والحافظة بين هاتفي والكمبيوتر. بلا حساب، ولا شيء يمر عبر السحابة. مجاني لأندرويد وويندوز وماك ولينكس: %1$s</string>
