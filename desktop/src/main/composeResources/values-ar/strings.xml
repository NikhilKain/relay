    <string name="help_get_apple_where">قيد التطوير</string>

    <string name="help_guide_title">خطوة بخطوة</string>
    <string name="help_guide_pick">أي جهازين؟</string>
    <string name="help_guide_phone_pc">هاتف وكمبيوتر</string>
    <string name="help_guide_two_phones">هاتفان</string>
    <string name="help_guide_two_pcs">كمبيوتران</string>

    <string name="help_pc_1_title">ثبّت التطبيقين</string>
    <string name="help_pc_1_body">Relay لسطح المكتب على هذا الكمبيوتر، وRelay لأندرويد على الهاتف من Google Play.</string>
    <string name="help_pc_2_title">شبكة Wi-Fi نفسها</string>
    <string name="help_pc_2_body">ضع الكمبيوتر والهاتف على الشبكة نفسها. إذا سأل Windows عن جدار الحماية، اختر السماح على الشبكات الخاصة.</string>
    <string name="help_pc_3_title">اتصل مرة واحدة</string>
    <string name="help_pc_3_body">يظهر الهاتف هنا ضمن أجهزة جديدة قريبة. انقره، وتحقق أن الشاشتين تعرضان الأشكال الثلاثة نفسها، ثم انقر الوثوق على الهاتف.</string>
    <string name="help_pc_4_title">هذا كل شيء</string>
    <string name="help_pc_4_body">انسخ على أحدهما والصق على الآخر. اسحب ملفًا إلى رف الإفلات على الحافة اليسرى للشاشة وأفلته على الهاتف، أو شارك إلى هذا الكمبيوتر من الهاتف.</string>

    <string name="help_phones_1_title">ثبّت Relay على الهاتفين</string>
    <string name="help_phones_1_body">يحتاج الهاتفان إلى التطبيق من Google Play. يمكن لأي منهما بدء الاتصال.</string>
    <string name="help_phones_2_title">شبكة Wi-Fi نفسها أو نقطة اتصال</string>
    <string name="help_phones_2_body">صِل الهاتفين بشبكة Wi-Fi نفسها. لا توجد Wi-Fi؟ شغّل نقطة الاتصال على أحد الهاتفين وصِل الآخر بها؛ لا حاجة للإنترنت.</string>
    <string name="help_phones_3_title">اتصل مرة واحدة</string>
    <string name="help_phones_3_body">على أي هاتف، انقر الآخر ضمن أجهزة جديدة قريبة. تحقق أن الشاشتين تعرضان الأشكال الثلاثة نفسها، ثم انقر الوثوق على الهاتف الثاني.</string>
    <string name="help_phones_4_title">هذا كل شيء</string>
    <string name="help_phones_4_body">شارك الصور والملفات بينهما من أي تطبيق، وألصق الهاتفين ظهرًا لظهر لتبادل بطاقات الاتصال.</string>

    <string name="help_pcs_1_title">ثبّت Relay لسطح المكتب على الاثنين</string>
    <string name="help_pcs_1_body">نزّله من GitHub لويندوز أو لينكس وشغّله على كل كمبيوتر. يبقى في علبة النظام.</string>
    <string name="help_pcs_2_title">الشبكة نفسها</string>
    <string name="help_pcs_2_body">الكمبيوتران على شبكة Wi-Fi نفسها أو الشبكة السلكية نفسها. اسمح لـ Relay عبر جدار الحماية على الشبكات الخاصة.</string>
    <string name="help_pcs_3_title">اتصل مرة واحدة</string>
    <string name="help_pcs_3_body">على أحد الكمبيوترين، انقر الآخر ضمن أجهزة جديدة قريبة. تحقق أن الشاشتين تعرضان الأشكال الثلاثة نفسها، ثم اختر الوثوق على الكمبيوتر الثاني.</string>
    <string name="help_pcs_4_title">هذا كل شيء</string>
    <string name="help_pcs_4_body">انسخ على كمبيوتر والصق على الآخر، أو اسحب الملفات إلى رف الإفلات على الحافة اليسرى للشاشة.</string>

    <string name="settings_ecosystem">المنظومة</string>
    <string name="settings_ecosystem_title">أجهزتك تعمل كجهاز واحد</string>
    <string name="settings_ecosystem_body">كل ما ترسله أجهزتك الموثوقة أو تفلته هنا يصل فورًا، دون زر قبول، وجاهز للصق.</string>
    <string name="settings_privacy">الخصوصية</string>
    <string name="settings_analytics_title">ساعد في تحسين Relay</string>
    <string name="settings_analytics_body">يرسل أعدادًا مجهولة مثل «اكتمل نقل»، ولا يرسل أبدًا أسماء الملفات أو النصوص أو هوية أجهزتك. متوقف افتراضيًا.</string>
    <string name="settings_shelf_title">رف الإفلات</string>
    <string name="settings_shelf_body">لسان رفيع على الحافة اليسرى للشاشة. اسحب إليه أي ملف أو نص، ثم أفلته على جهاز.</string>

